{
  "manifest_version": 3,
  "name": "商标调查人工固证助手",
  "version": "1.0.0",
  "description": "仅在人工点击时归档当前销售平台页面，并发送到本机工作站。",
  "permissions": [
    "activeTab",
    "debugger",
    "notifications",
    "pageCapture",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "人工固证",
    "default_popup": "popup.html"
  }
}
